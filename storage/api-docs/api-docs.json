    "components": {
        "schemas": {
            "LoginRequest": {
                "required": [
                    "email",
                    "password"
                ],
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "user@booknest.com"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "example": "password123"
                    }
                },
                "type": "object"
            },
            "RefreshTokenRequest": {
                "required": [
                    "refresh_token"
                ],
                "properties": {
                    "refresh_token": {
                        "type": "string",
                        "example": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..."
                    }
                },
                "type": "object"
            },
            "RegisterRequest": {
                "required": [
                    "email",
                    "password",
                    "password_confirmation",
                    "username"
                ],
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "user@booknest.com"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "example": "password123"
                    },
                    "password_confirmation": {
                        "type": "string",
                        "format": "password",
                        "example": "password123"
                    },
                    "username": {
                        "type": "string",
                        "example": "user12"
                    },
                    "role": {
                        "type": "string",
                        "example": "reader",
                        "enum": [
                            "reader",
                            "author"
                        ]
                    },
                    "genre_preference": {
                        "type": "string",
                        "example": "fantasy"
                    }
                },
                "type": "object"
            },
            "CreateBookRequest": {
                "required": [
                    "title",
                    "synopsis",
                    "genre_id"
                ],
                "properties": {
                    "title": {
                        "type": "string",
                        "example": "The Last Dragon"
                    },
                    "synopsis": {
                        "type": "string",
                        "example": "A story about the last dragon in a dying world..."
                    },
                    "genre_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "tags": {
                        "type": "array",
                        "items": {
                            "type": "integer",
                            "example": 3
                        }
                    },
                    "content_rating": {
                        "type": "string",
                        "example": "teen",
                        "enum": [
                            "everyone",
                            "teen",
                            "mature"
                        ]
                    },
                    "cover_image": {
                        "type": "string",
                        "example": "https://cloudinary.com/cover.jpg"
                    }
                },
                "type": "object"
            },
            "UpdateBookRequest": {
                "properties": {
                    "synopsis": {
                        "type": "string",
                        "example": "An updated synopsis..."
                    },
                    "genre_id": {
                        "type": "integer",
                        "example": 2
                    },
                    "tags": {
                        "type": "array",
                        "items": {
                            "type": "integer",
                            "example": 3
                        }
                    },
                    "content_rating": {
                        "type": "string",
                        "example": "mature",
                        "enum": [
                            "everyone",
                            "teen",
                            "mature"
                        ]
                    },
                    "cover_image": {
                        "type": "string",
                        "example": "https://cloudinary.com/newcover.jpg"
                    }
                },
                "type": "object"
            },
            "CreateChapterRequest": {
                "required": [
                    "title",
                    "content"
                ],
                "properties": {
                    "title": {
                        "type": "string",
                        "example": "The Beginning"
                    },
                    "content": {
                        "type": "string",
                        "example": "It was a dark and stormy night when the last dragon spread its wings..."
                    }
                },
                "type": "object"
            },
            "UpdateChapterRequest": {
                "properties": {
                    "title": {
                        "type": "string",
                        "example": "The Beginning Revised"
                    },
                    "content": {
                        "type": "string",
                        "example": "It was a bright and stormy night when the last dragon spread its wings..."
                    }
                },
                "type": "object"
            },
            "TokenResponse": {
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "success"
                    },
                    "message": {
                        "type": "string",
                        "example": "Login successful."
                    },
                    "data": {
                        "properties": {
                            "access_token": {
                                "type": "string",
                                "example": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..."
                            },
                            "refresh_token": {
                                "type": "string",
                                "example": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..."
                            },
                            "token_type": {
                                "type": "string",
                                "example": "Bearer"
                            },
                            "expires_in": {
                                "type": "integer",
                                "example": 3600
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "UserResponse": {
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "success"
                    },
                    "data": {
                        "properties": {
                            "id": {
                                "type": "integer",
                                "example": 1
                            },
                            "email": {
                                "type": "string",
                                "example": "ayanfe@booknest.com"
                            },
                            "username": {
                                "type": "string",
                                "example": "ayanfe"
                            },
                            "display_name": {
                                "type": "string",
                                "example": "Ayanfe"
                            },
                            "avatar": {
                                "type": "string",
                                "example": "https://cloudinary.com/avatar.jpg"
                            },
                            "role": {
                                "type": "string",
                                "example": "author"
                            },
                            "genre_preference": {
                                "type": "string",
                                "example": "fantasy"
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "BookListResponse": {
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "success"
                    },
                    "data": {
                        "properties": {
                            "data": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/BookResponse"
                                }
                            },
                            "current_page": {
                                "type": "integer",
                                "example": 1
                            },
                            "per_page": {
                                "type": "integer",
                                "example": 15
                            },
                            "total": {
                                "type": "integer",
                                "example": 100
                            },
                            "last_page": {
                                "type": "integer",
                                "example": 7
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "BookResponse": {
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "success"
                    },
                    "data": {
                        "properties": {
                            "id": {
                                "type": "integer",
                                "example": 1
                            },
                            "title": {
                                "type": "string",
                                "example": "The Last Dragon"
                            },
                            "slug": {
                                "type": "string",
                                "example": "the-last-dragon"
                            },
                            "synopsis": {
                                "type": "string",
                                "example": "A story about the last dragon..."
                            },
                            "cover_image": {
                                "type": "string",
                                "example": "https://cloudinary.com/cover.jpg"
                            },
                            "status": {
                                "type": "string",
                                "example": "draft"
                            },
                            "content_rating": {
                                "type": "string",
                                "example": "teen"
                            },
                            "total_reads": {
                                "type": "integer",
                                "example": 0
                            },
                            "total_collections": {
                                "type": "integer",
                                "example": 0
                            },
                            "total_dragons": {
                                "type": "integer",
                                "example": 0
                            },
                            "is_locked": {
                                "type": "boolean",
                                "example": false
                            },
                            "published_at": {
                                "type": "string",
                                "example": null
                            },
                            "genre": {
                                "properties": {
                                    "id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "name": {
                                        "type": "string",
                                        "example": "Fantasy"
                                    },
                                    "slug": {
                                        "type": "string",
                                        "example": "fantasy"
                                    }
                                },
                                "type": "object"
                            },
                            "tags": {
                                "type": "array",
                                "items": {
                                    "properties": {
                                        "id": {
                                            "type": "integer",
                                            "example": 1
                                        },
