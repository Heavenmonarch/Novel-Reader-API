                "responses": {
                    "200": {
                        "description": "Book published successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BookResponse"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Forbidden — not owner"
                    },
                    "422": {
                        "description": "No chapters or already published"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
