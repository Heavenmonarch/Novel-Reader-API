        },
        "/books/update-book/{book}": {
            "patch": {
                "tags": [
                    "Books"
                ],
                "summary": "Update a draft book synopsis, cover, genre or tags",
                "operationId": "1313c04474992a84d2e140cc538b37a8",
                "parameters": [
                    {
                        "name": "book",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "example": 1
